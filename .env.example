# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push VAPID Public Key (Safe to expose to client for PushManager.subscribe)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Admin Dashboard Access PIN (Accessed via footer ⏰ icon)
VITE_ADMIN_PIN=188199

# Backend Secrets (Server / Supabase Edge Functions only - NEVER put private key in VITE_*)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@example.com

